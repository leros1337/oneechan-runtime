# Eclipse OpenJ9 options for the embedded extension host. jvm-ios/package.sh bundles this file as
# jre/lib/oneechan-jvm.options; EmbeddedRuntime.bundled() reads it and JNITransport fills in
# ${dataDir}, ${cacheDir}, ${tmpDir} and ${javaHome}. One option per line; -Xmx, the class path,
# java.home and the directories are added by JNITransport for every VM.
#
# Interpreter only: iOS forbids writable+executable memory, and the build links no JIT.
-Xint
-Xnojit
-Xnoaot
# Extensions are R8-optimized for ART and fail the JVM verifier (EmbeddedBridge refuses to start
# while it is on). OpenJ9 21 prints a deprecation warning (JVMJ9VM193W) for it.
-Xverify:none
# Generational concurrent GC, OpenJ9's default, spelled out.
-Xgcpolicy:gencon
# Heap start, from -Xverbosegclog runs of the host: with OpenJ9's default 8 MB heap (2 MB nursery),
# a launch-like workload ran about 10 global collections, some with compaction, in its first 2 s
# while the tenured space grew. 32 MB of tenured space is committed but only touched as it fills;
# the nursery starts at 8 MB and may grow to 16 MB (by default up to a quarter of -Xmx). Measured:
# +5-7 MB footprint after start, about 5 MB less than the default under load. -Xms must stay at or
# below the -Xmx that JNITransport passes (512 MB by default).
-Xms40m
-Xmns8m
-Xmnx16m
# Two GC threads, not one per CPU: about 30% less GC CPU time for the same collections (more threads
# mostly wait on each other), for slightly longer pauses.
-Xgcthreads2
# No shared classes cache: it lives in memory-mapped files and SysV semaphores outside the app's
# sandbox conventions, and is not built for iOS.
-Xshareclasses:none
# No attach API: it needs a shared /tmp directory and SysV semaphores.
-Dcom.ibm.tools.attach.enable=no
# Diagnostics: javacore files go to the cache directory; no core or heap dumps.
-Xdump:directory=${cacheDir}
-Xdump:system:none
-Xdump:heap:none
# No trace engine (it costs startup time and CPU on every tracepoint). Javacores keep everything they
# show today: their trace history sections are empty anyway, because the jre has no trace format
# files. Lost: the binary Snap*.trc next to a crash javacore.
-Xtrace:none
